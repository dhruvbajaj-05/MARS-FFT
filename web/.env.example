# API origin (no trailing slash, no /api/v1 — that is appended automatically).
# Defaults to the production backend if this file/variable is absent.
#
# Local backend example:  VITE_API_ORIGIN=http://localhost:5000
# Production (default):    VITE_API_ORIGIN=https://mars-fft-production.up.railway.app
VITE_API_ORIGIN=https://mars-fft-production.up.railway.app
